# AMAN 360 — environment configuration (copy to .env.local)
# All values are optional; the demo runs fully offline-capable with defaults.

# Demo mode opens straight into the command center (no sign-in). Set to 1 to require operator
# sign-in — do this for any shared or hosted deployment.
AMAN_REQUIRE_LOGIN=

# Operator passcode used when sign-in is required. Demo-only — never reuse a real credential.
AMAN_OPERATOR_PASSCODE=aman-demo-2026

# Secret used to sign operator session cookies. If unset, a random secret is generated
# per server start (sessions then reset when the server restarts).
AMAN_SESSION_SECRET=

# Optional: enables the LLM communication layer (server-side only, never sent to the browser).
# Without it, AMAN uses the approved bilingual template library and deterministic classifiers,
# and the UI labels the communication mode accordingly.
# Also powers the live "Ask AMAN" copilot (otherwise it answers from labelled keyword rules).
# Use the secret key (sk-ant-api03-…), not the apikey_01… id shown in the console's key list.
ANTHROPIC_API_KEY=
AMAN_LLM_MODEL=claude-opus-5-5
# Optional: override the API base URL (a generic ANTHROPIC_BASE_URL in your shell is ignored).
AMAN_ANTHROPIC_BASE_URL=

# Optional: Oriane video-search key, only needed to re-fetch the real-world replay data
# (scripts/fetch-social.mjs). The app itself ships the fetched, reduced dataset and never calls Oriane.
ORIANE_API_KEY=

# SQLite database location (default: .data/aman360.db)
AMAN_DB_PATH=
