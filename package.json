{
  "name": "aman360",
  "version": "0.1.0",
  "private": true,
  "description": "AMAN 360 — AI-assisted emergency communication and response platform (training prototype, synthetic data).",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "npm install && npm run db:reset",
    "dev": "next dev -p 3360",
    "build": "next build",
    "start": "next start -p 3360",
    "demo": "npm run build && npm run start",
    "typecheck": "tsc --noEmit",
    "db:reset": "tsx scripts/reset-db.ts",
    "data:osm": "node scripts/fetch-osm.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "screenshots": "playwright test tests/e2e/screenshots.spec.ts --project=chromium"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.137.0",
    "@fontsource-variable/readex-pro": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@turf/turf": "7.4.0",
    "better-sqlite3": "13.0.3",
    "clsx": "2.1.1",
    "gsap": "3.15.0",
    "maplibre-gl": "5.24.0",
    "motion": "12.43.0",
    "next": "16.4.2",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "three": "0.186.1",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/geojson": "7946.0.16",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.186.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
